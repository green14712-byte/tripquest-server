// use prisma-8

enum UserRole {
  USER
  INSTITUTION
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum InstitutionApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

// Mission 인증 방식
enum MissionVerificationMode {
  // GPS 위치 인증만 성공하면 완료
  LOCATION_ONLY

  // GPS 위치 인증과 QR 인증이 모두 성공해야 완료
  LOCATION_AND_QR

  // GPS 위치 인증 또는 QR 인증 중 하나만 성공해도 완료
  LOCATION_OR_QR
}

// Mission 자체의 운영 상태
enum MissionStatus {
  // 현재 Challenge의 유효한 수행 대상
  ACTIVE

  // 더 이상 현재 Challenge의 수행 대상이 아님
  // 과거 완료 기록은 그대로 보존
  INACTIVE
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  nickname String?

  // 일반 이메일 계정은 passwordHash 사용
  // Google 계정은 passwordHash가 NULL일 수 있음
  passwordHash String?

  // Google 계정 고유 식별자
  googleSub String? @unique

  // 이메일 인증 상태
  emailVerified   Boolean            @default(false)
  emailVerifiedAt TimestamptzString?

  // 권한
  role UserRole @default(USER)

  // 계정 상태
  status           AccountStatus      @default(ACTIVE)
  suspendedAt      TimestamptzString?
  suspensionReason String?
  deletedAt        TimestamptzString?

  // 기관 계정인 경우 연결된 기관
  institutionId Int?
  institution   Institution? @relation(
    fields: [institutionId],
    references: [id]
  )

  // 본인이 신청한 기관 가입 신청
  institutionApplications InstitutionApplication[]
    @relation("InstitutionApplicant")

  // 관리자로서 검토한 기관 가입 신청
  reviewedInstitutionApplications InstitutionApplication[]
    @relation("InstitutionReviewer")

  participations     ChallengeParticipation[]
  missionCompletions MissionCompletion[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@map("users")
}

model EmailVerification {
  id Int @id @default(autoincrement())

  email String @unique

  // 6자리 인증번호는 원문이 아닌 Hash 저장
  codeHash String

  // 인증번호 만료시간
  expiresAt TimestamptzString

  // 무차별 대입 방지를 위한 실패 횟수
  attemptCount Int @default(0)

  // 인증번호 검증 성공 시간
  verifiedAt TimestamptzString?

  // 실제 회원가입 단계에서 사용하는 일회용 토큰
  verificationTokenHash      String?
  verificationTokenExpiresAt TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@map("email_verifications")
}

model PasswordReset {
  id Int @id @default(autoincrement())

  // 비밀번호 재설정을 요청한 이메일
  email String @unique

  // 6자리 인증번호는 원문이 아닌 Hash 저장
  codeHash String

  // 인증번호 만료시간
  expiresAt TimestamptzString

  // 무차별 대입 방지를 위한 실패 횟수
  attemptCount Int @default(0)

  // 인증번호 검증 성공 시간
  verifiedAt TimestamptzString?

  // 실제 비밀번호 재설정 단계에서 사용하는 일회용 토큰
  resetTokenHash String?

  // 재설정 토큰 만료시간
  resetTokenExpiresAt TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@map("password_resets")
}

model Institution {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  users      User[]
  challenges Challenge[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@map("institutions")
}

model InstitutionApplication {
  id Int @id @default(autoincrement())

  applicantId Int
  applicant   User @relation(
    "InstitutionApplicant",
    fields: [applicantId],
    references: [id]
  )

  // 기관 정보
  institutionName    String
  representativeName String
  contactEmail       String
  contactPhone       String?
  address            String?
  website            String?
  description        String?

  // 기존 단일 증빙파일 경로
  //
  // 기존 신청 데이터와의 호환을 위해
  // 다중 증빙자료 전환 완료 전까지 유지
  proofFileKey String?

  // 새로운 다중 증빙자료
  proofs InstitutionApplicationProof[]

  // 신청 상태
  status InstitutionApplicationStatus @default(PENDING)

  // 신청을 검토한 관리자
  reviewerId Int?
  reviewer   User? @relation(
    "InstitutionReviewer",
    fields: [reviewerId],
    references: [id]
  )

  reviewedAt      TimestamptzString?
  rejectionReason String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@map("institution_applications")
}

model InstitutionApplicationProof {
  id Int @id @default(autoincrement())

  applicationId Int
  application   InstitutionApplication @relation(
    fields: [applicationId],
    references: [id]
  )

  fileKey String @unique

  originalName String

  mimeType String

  fileSize Int

  createdAt TimestamptzString @default(now())

  @@index([applicationId])

  @@map("institution_application_proofs")
}

model Challenge {
  id          Int             @id @default(autoincrement())
  title       String
  description String?
  region      String?
  status      ChallengeStatus @default(DRAFT)

  startAt TimestamptzString?
  endAt   TimestamptzString?

  // Challenge 대표사진
  //
  // 실제 이미지 자체를 DB에 저장하지 않고
  // Supabase Storage 내부 경로만 저장한다.
  //
  // 예:
  // challenge-covers/15/uuid.jpg
  coverImageKey String?

  // Challenge 대표사진 초점 위치
  //
  // 0 ~ 100 백분율 좌표를 사용한다.
  //
  // 50, 50
  // → 사진 정중앙
  //
  // 화면에서는 CSS object-position에 사용한다.
  coverPositionX Float @default(50)
  coverPositionY Float @default(50)

  institutionId Int
  institution   Institution @relation(
    fields: [institutionId],
    references: [id]
  )

  missions       Mission[]
  participations ChallengeParticipation[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@map("challenges")
}

model Mission {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  address     String?

  // Mission 관광지 대표사진
  //
  // 실제 이미지 자체를 DB에 저장하지 않고
  // Supabase Storage 내부 경로만 저장한다.
  //
  // 예:
  // mission-photos/25/uuid.jpg
  photoImageKey String?

  // Mission 관광지 대표사진 초점 위치
  //
  // 0 ~ 100 백분율 좌표를 사용한다.
  //
  // 50, 50
  // → 사진 정중앙
  //
  // 화면에서는 CSS object-position에 사용한다.
  photoPositionX Float @default(50)
  photoPositionY Float @default(50)

  // Mission 자체의 현재 운영 상태
  status MissionStatus @default(ACTIVE)

  // 기관이 지도에서 지정한 Mission 중심 좌표
  latitude  Float
  longitude Float

  // GPS 인증 가능 반경(m)
  verificationRadius Int @default(100)

  // Mission 인증 정책
  verificationMode MissionVerificationMode
    @default(LOCATION_AND_QR)

  // QR 설치 위치에 대한 사용자 안내
  qrLocationNote String?

  // QR 원문은 평문으로 저장하지 않고
  // 인증 비교용 Hash만 저장
  qrTokenHash String? @unique

  // 기관이 나중에 동일한 QR을 다시 확인할 수 있도록
  // 원본 토큰을 AES-256-GCM으로 암호화하여 저장
  qrTokenEncrypted String?

  // QR 인증 기능 사용 여부
  qrActive Boolean @default(false)

  sortOrder Int @default(0)

  challengeId Int
  challenge   Challenge @relation(
    fields: [challengeId],
    references: [id]
  )

  completions MissionCompletion[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@map("missions")
}

model ChallengeParticipation {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(
    fields: [userId],
    references: [id]
  )

  challengeId Int
  challenge   Challenge @relation(
    fields: [challengeId],
    references: [id]
  )

  joinedAt TimestamptzString @default(now())

  @@unique([userId, challengeId])
  @@map("challenge_participations")
}

model MissionCompletion {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(
    fields: [userId],
    references: [id]
  )

  missionId Int
  mission   Mission @relation(
    fields: [missionId],
    references: [id]
  )

  // 실제 완료에 사용된 인증 수단
  verificationMethod String @default("BOTH")

  // USER가 Mission 인증 완료 후 등록한 개인 완료사진
  //
  // 실제 이미지는 Storage에 저장하고
  // DB에는 Storage key만 저장한다.
  photoImageKey String?

  verifiedAt TimestamptzString @default(now())

  @@unique([userId, missionId])
  @@map("mission_completions")
}